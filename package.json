{
  "name": "hiplot-plus",
  "version": "0.0.3",
  "description": "HiPlot is a lightweight interactive visualization tool to help AI researchers discover correlations and patterns in high-dimensional data using parallel plots and other graphical ways to represent information.",
  "homepage": "https://github.com/poipoi300/hiplot#readme",
  "bugs": {
    "url": "https://github.com/poipoi300/hiplot/issues"
  },
  "license": "MIT",
  "author": "Facebook AI Research",
  "repository": {
    "type": "git",
    "url": "https://github.com/poipoi300/hiplot.git"
  },
  "type": "module",
  "main": "npm-dist/hiplot.lib.js",
  "types": "npm-dist/hiplot.d.ts",
  "scripts": {
    "build": "bun run tcm && bun run vite:build:web && bun run vite:build:test && bun run vite:build:streamlit && bun run vite:build:lib",
    "tcm": "bunx --bun tcm src",
    "vite:build:web": "HIPLOT_WEB_NAME=hiplot HIPLOT_WEB_ENTRY=./src/hiplot_web.tsx vite build -c vite.web.config.mts",
    "vite:build:test": "HIPLOT_WEB_NAME=hiplot_test HIPLOT_WEB_ENTRY=./src/hiplot_selftest.tsx vite build -c vite.web.config.mts",
    "vite:build:streamlit": "HIPLOT_WEB_NAME=hiplot_streamlit HIPLOT_WEB_ENTRY=./src/hiplot_streamlit.tsx vite build -c vite.web.config.mts",
    "vite:build:lib": "vite build -c vite.lib.config.mts",
    "vite:dev": "vite -c vite.web.config.mts",
    "fmt": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "bun run tcm && tsc --noEmit -p .",
    "test:js": "playwright test",
    "prepublish": "bun run tcm && bun run prepublish-ts",
    "prepublish-ts": "tsc -p tsconfig.lib.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.4",
    "@types/d3": "^7.4.3",
    "@types/hoist-non-react-statics": "^3.3.7",
    "@types/jquery": "^3.5.33",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/underscore": "^1.13.0",
    "@vitejs/plugin-react": "^5.1.3",
    "bootstrap": "^5.3.8",
    "color": "^5.0.3",
    "d3": "^7.9.0",
    "datatables.net": "^2.3.7",
    "datatables.net-bs5": "^2.3.7",
    "datatables.net-buttons": "^3.2.6",
    "datatables.net-buttons-bs5": "^3.2.6",
    "datatables.net-colreorder-bs5": "^2.1.2",
    "happy-dom": "^21.0.4",
    "hoist-non-react-statics": "^3.3.2",
    "jquery": "^3.7.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.4.0",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.9.3",
    "underscore": "^1.13.7",
    "vite": "^7.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-istanbul": "^9.0.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "overrides": {
    "@babel/traverse": "^7.23.2",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "json5": "^2.2.3",
    "semver": "^7.5.4"
  }
}
